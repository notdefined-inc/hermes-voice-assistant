@@ -0,0 +1,172 @@
+"""Coverage for the ElevenLabs Realtime STT single-use token endpoint.
+
+Exercises _handle_stt_elevenlabs_token in-process via a fake handler. The happy
+path mocks urllib so no real ElevenLabs network call is made; the rejection
+paths (wrong method, missing key, upstream failure) bail before/around the call.
+"""
+import io
+import json
+import types
+
+import pytest
+
+import api.routes as routes
+
+
+class _FakeHandler:
+    def __init__(self, body: bytes, command: str = "POST", headers=None, client="9.9.9.9"):
+        self.command = command
+        self.rfile = io.BytesIO(body)
+        self.wfile = io.BytesIO()
+        self.headers = headers or {}
+        self.headers.setdefault("Content-Length", str(len(body)))
+        self.client_address = (client, 12345)
+        self.status = None
+        self.sent_headers = {}
+
+    def send_response(self, status):
+        self.status = status
+
+    def send_header(self, key, value):
+        self.sent_headers[key] = value
+
+    def end_headers(self):
+        pass
+
+    def payload(self):
+        try:
+            return json.loads(self.wfile.getvalue().decode("utf-8"))
+        except Exception:
+            return None
+
+
+class _FakeResp:
+    def __init__(self, body: bytes):
+        self._body = body
+
+    def read(self, n=-1):
+        return self._body
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *a):
+        return False
+
+
+@pytest.fixture(autouse=True)
+def _fresh(monkeypatch):
+    import api.auth as _auth
+    monkeypatch.setattr(_auth, "is_auth_enabled", lambda: False)
+    monkeypatch.setattr(routes, "is_auth_enabled", lambda: False, raising=False)
+    monkeypatch.delenv("HERMES_WEBUI_TRUST_FORWARDED_FOR", raising=False)
+    if hasattr(routes._handle_stt_elevenlabs_token, "_limiter"):
+        del routes._handle_stt_elevenlabs_token._limiter
+    yield
+    if hasattr(routes._handle_stt_elevenlabs_token, "_limiter"):
+        del routes._handle_stt_elevenlabs_token._limiter
+
+
+def test_token_requires_post():
+    h = _FakeHandler(b"", command="GET")
+    routes._handle_stt_elevenlabs_token(h, None)
+    assert h.status == 405
+
+
+def test_token_missing_key_returns_503(monkeypatch, tmp_path):
+    monkeypatch.delenv("ELEVENLABS_API_KEY", raising=False)
+    import api.profiles as profiles
+    monkeypatch.setattr(profiles, "get_active_hermes_home", lambda: tmp_path)
+    h = _FakeHandler(b"{}")
+    routes._handle_stt_elevenlabs_token(h, None)
+    assert h.status == 503
+    assert "ELEVENLABS_API_KEY" in (h.payload() or {}).get("error", "")
+
+
+def test_token_happy_path_mints_token(monkeypatch):
+    monkeypatch.setenv("ELEVENLABS_API_KEY", "sk-test")
+    captured = {}
+
+    def fake_urlopen(req, timeout=15):
+        captured["url"] = req.full_url
+        # urllib title-cases header keys; find case-insensitively.
+        for k, v in dict(req.headers.items()).items():
+            if k.lower() == "xi-api-key":
+                captured["key"] = v
+        return _FakeResp(json.dumps({"token": "sutkn_abc123"}).encode())
+
+    import urllib.request as _ur
+    monkeypatch.setattr(_ur, "urlopen", fake_urlopen)
+    h = _FakeHandler(b"{}")
+    routes._handle_stt_elevenlabs_token(h, None)
+    assert h.status == 200
+    assert (h.payload() or {}).get("token") == "sutkn_abc123"
+    assert "single-use-token/realtime_scribe" in captured.get("url", "")
+    assert captured.get("key") == "sk-test"
+
+
+def test_token_upstream_failure_returns_502(monkeypatch):
+    monkeypatch.setenv("ELEVENLABS_API_KEY", "sk-test")
+
+    def boom(req, timeout=15):
+        raise OSError("network down")
+
+    import urllib.request as _ur
+    monkeypatch.setattr(_ur, "urlopen", boom)
+    h = _FakeHandler(b"{}")
+    routes._handle_stt_elevenlabs_token(h, None)
+    assert h.status == 502
+
+
+def test_token_empty_payload_returns_502(monkeypatch):
+    monkeypatch.setenv("ELEVENLABS_API_KEY", "sk-test")
+    import urllib.request as _ur
+    monkeypatch.setattr(_ur, "urlopen", lambda req, timeout=15: _FakeResp(b"{}"))
+    h = _FakeHandler(b"{}")
+    routes._handle_stt_elevenlabs_token(h, None)
+    assert h.status == 502
+
+
+def test_token_limiter_allows_speech_burst(monkeypatch):
+    """Rapid follow-up utterances (barge-in) must not be 429'd.
+
+    The limiter allows up to 3 mints per 5 s window — speech bursts routinely
+    mint one token per utterance, sometimes <5 s apart (observed live: a
+    follow-up 3.9 s after the previous utterance was blocked).
+    """
+    monkeypatch.setenv("ELEVENLABS_API_KEY", "sk-test")
+    import urllib.request as _ur
+    monkeypatch.setattr(_ur, "urlopen", lambda req, timeout=15: _FakeResp(json.dumps({"token": "sutkn_burst"}).encode()))
+
+    h1 = _FakeHandler(b"{}", client="10.0.0.1")
+    routes._handle_stt_elevenlabs_token(h1, None)
+    assert h1.status == 200
+
+    h2 = _FakeHandler(b"{}", client="10.0.0.1")
+    routes._handle_stt_elevenlabs_token(h2, None)
+    assert h2.status == 200
+
+    h3 = _FakeHandler(b"{}", client="10.0.0.1")
+    routes._handle_stt_elevenlabs_token(h3, None)
+    assert h3.status == 200
+
+    h4 = _FakeHandler(b"{}", client="10.0.0.1")
+    routes._handle_stt_elevenlabs_token(h4, None)
+    assert h4.status == 429  # burst exhausted
+
+
+def test_token_limiter_is_per_client(monkeypatch):
+    """A second client is not limited by the first client's mints."""
+    monkeypatch.setenv("ELEVENLABS_API_KEY", "sk-test")
+    import urllib.request as _ur
+    monkeypatch.setattr(_ur, "urlopen", lambda req, timeout=15: _FakeResp(json.dumps({"token": "sutkn_x"}).encode()))
+
+    for i in range(4):
+        h = _FakeHandler(b"{}", client="10.0.0.2")
+        routes._handle_stt_elevenlabs_token(h, None)
+        # Burst of 3 allowed; the 4th within the window is blocked.
+        assert h.status == (429 if i >= 3 else 200)
+
+    h = _FakeHandler(b"{}", client="10.0.0.3")
+    routes._handle_stt_elevenlabs_token(h, None)
+    assert h.status == 200
