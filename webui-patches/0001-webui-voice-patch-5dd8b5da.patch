+def _handle_stt_elevenlabs_token(handler, parsed):
+    """Mint a single-use ElevenLabs Realtime STT token for the voice assistant.
+
+    The ElevenLabs Realtime STT WebSocket accepts a short-lived single-use
+    token (``POST /v1/single-use-token/realtime_scribe``) so the browser can
+    stream microphone audio directly to api.elevenlabs.io without ever seeing
+    the account API key. Tokens expire after 15 minutes and are consumed on
+    use.
+
+    POST /api/stt/elevenlabs-token  →  {"ok": true, "token": "sutkn_..."}
+    """
+    if handler.command != "POST":
+        from api.helpers import bad as _bad
+        return _bad(handler, "POST required for /api/stt/elevenlabs-token", 405)
+
+    from api.auth import is_auth_enabled, parse_cookie, verify_session
+    if is_auth_enabled():
+        cv = parse_cookie(handler)
+        if not (cv and verify_session(cv)):
+            from api.helpers import bad as _bad
+            return _bad(handler, "unauthorized", 401)
+
+    # Per-client rate limiting (tokens mint against the paid ElevenLabs API,
+    # but minting itself is free — so we allow a small burst: up to 3 tokens
+    # per 5 s window. Speech bursts (rapid follow-up utterances, barge-in)
+    # routinely mint one token per utterance, sometimes <5 s apart.)
+    if not hasattr(_handle_stt_elevenlabs_token, "_limiter"):
+        import time as _time, threading as _threading
+
+        class _TokenLimiter:
+            def __init__(self, max_burst=3, window_seconds=5.0, prune_interval=25):
+                self.max_burst = max_burst
+                self.window = window_seconds
+                self.prune_interval = prune_interval
+                self._hits = {}
+                self._lock = _threading.Lock()
+                self._checks = 0
+
+            def check(self, h):
+                key = str(getattr(h, "client_address", ("unknown",))[0])
+                now = _time.time()
+                with self._lock:
+                    self._checks += 1
+                    if self._checks % self.prune_interval == 0:
+                        cutoff = now - (self.window * 10)
+                        self._hits = {k: [t for t in v if t > cutoff] for k, v in self._hits.items()}
+                    hits = [t for t in self._hits.get(key, []) if now - t < self.window]
+                    if len(hits) >= self.max_burst:
+                        return False
+                    hits.append(now)
+                    self._hits[key] = hits
+                    return True
+
+        _handle_stt_elevenlabs_token._limiter = _TokenLimiter()
+    if not _handle_stt_elevenlabs_token._limiter.check(handler):
+        from api.helpers import bad as _bad
+        return _bad(handler, "rate limit exceeded — please wait", 429)
+
+    # ElevenLabs API key: env → Hermes .env (same fallback chain as TTS).
+    api_key = os.getenv("ELEVENLABS_API_KEY", "").strip()
+    if not api_key:
+        try:
+            from api.onboarding import _load_env_file
+            from api.profiles import get_active_hermes_home
+            api_key = _load_env_file(get_active_hermes_home() / ".env").get("ELEVENLABS_API_KEY", "")
+        except Exception:
+            pass
+    if not api_key:
+        from api.helpers import bad as _bad
+        return _bad(handler, "ELEVENLABS_API_KEY not configured", 503)
+
+    from urllib.request import Request, urlopen
+    try:
+        req = Request(
+            "https://api.elevenlabs.io/v1/single-use-token/realtime_scribe",
+            data=b"",
+            headers={"xi-api-key": api_key, "Accept": "application/json"},
+        )
+        with urlopen(req, timeout=15) as resp:
+            payload = json.loads(resp.read().decode("utf-8") or "{}")
+        token = str(payload.get("token") or "").strip()
+        if not token:
+            logger.warning("ElevenLabs single-use token response missing 'token'")
+            from api.helpers import bad as _bad
+            return _bad(handler, "ElevenLabs token mint failed", 502)
+        return j(handler, {"ok": True, "token": token})
+    except Exception:
+        logger.exception("ElevenLabs single-use token mint failed")
+        from api.helpers import bad as _bad
+        return _bad(handler, "ElevenLabs token mint failed", 502)
+
