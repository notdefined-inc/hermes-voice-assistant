diff --git a/api/upload.py b/api/upload.py
index ba5999ad..82ca9a3f 100644
--- a/api/upload.py
+++ b/api/upload.py
@@ -436,6 +436,27 @@ def handle_transcribe(handler):
         except ImportError:
             return j(handler, {'error': 'Speech-to-text is unavailable on this server'}, status=503)
         result = transcribe_audio(temp_path)
+        # Optional request-level STT provider override (e.g. the voice-assistant
+        # extension forwards the user's engine choice: local/groq/openai/mistral/
+        # xai/elevenlabs/deepinfra). Hermes' transcribe_audio() does not accept a
+        # provider kwarg — it routes by model name. Map the extension's provider
+        # names to model names so the override actually works.
+        # Empty = server auto-detect (config wins).
+        _STT_PROVIDER_MODELS = {
+            'local': None,           # local faster-whisper, no model override needed
+            'groq': 'whisper-large-v3-turbo',
+            'openai': 'whisper-1',
+            'mistral': 'whisper-1',  # Mistral Voxtral not wired yet; fall back
+            'xai': 'whisper-1',
+            'deepinfra': 'whisper-large-v3',
+        }
+        provider = str(fields.get('provider') or '').strip()
+        if provider and provider in _STT_PROVIDER_MODELS:
+            model_override = _STT_PROVIDER_MODELS[provider]
+            if model_override:
+                result = transcribe_audio(temp_path, model=model_override)
+            else:
+                result = transcribe_audio(temp_path)
         if not result.get('success'):
             msg = str(result.get('error') or 'Transcription failed')
             status = 503 if 'unavailable' in msg.lower() or 'not configured' in msg.lower() else 400
